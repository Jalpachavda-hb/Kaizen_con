# =====================================================================
# Kaizen_con Root .gitignore
# =====================================================================

# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak
.pnp
.pnp.js

# Production & Build outputs
dist/
dist-ssr/
build/
out/
*/dist/
*/build/

# Executables, installers & binary packages (prevents GitHub 100MB limit issues)
*.exe
*.msi
*.dmg
*.pkg
*.deb
*.rpm
*.bin
*.dll
*.iso
*.apk
*.app

# Large Archives & Compressed files
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Environment variables & local configuration
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & IDE directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temporary, scratch & cache files
.cache/
.temp/
.tmp/
*.tmp
*.bak
*.swp
*.patch
.eslintcache

# Unnecessary local files
kaizen_con/src/assets/home/*.exe
kaizen_con/src/assets/home/Employee_Management_System_MERN_Task.pdf

